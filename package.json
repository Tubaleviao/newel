{
  "name": "newel",
  "version": "0.0.1",
  "description": "TypeScript library to define your application's meaning, behavior, entities and state machines — generate all artifacts from a single source of truth",
  "keywords": [
    "newel",
    "codegen",
    "schema",
    "openapi",
    "rdf",
    "owl"
  ],
  "homepage": "https://github.com/Tubaleviao/newel#readme",
  "bugs": {
    "url": "https://github.com/Tubaleviao/newel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Tubaleviao/newel.git"
  },
  "license": "MIT",
  "author": "Tubaleviao",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  }
}
